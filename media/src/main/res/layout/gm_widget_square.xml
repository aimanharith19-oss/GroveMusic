<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FF0B6B45">
    <ImageView android:id="@+id/w_art" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical"
        android:background="#B3000000" android:padding="8dp">
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFFFF"
            android:textSize="15sp" android:fontFamily="sans-serif-light" android:singleLine="true" android:ellipsize="end" android:text="GroveMedia" />
        <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B3FFFFFF"
            android:textSize="11sp" android:singleLine="true" android:ellipsize="end" android:text="" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
            <ImageButton android:id="@+id/w_prev" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_n_prev" android:background="@null" android:contentDescription="previous" />
            <ImageButton android:id="@+id/w_play" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_n_play" android:background="@null" android:contentDescription="play" />
            <ImageButton android:id="@+id/w_next" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_n_next" android:background="@null" android:contentDescription="next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
