<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
    android:background="@drawable/gm_widget_bg" android:gravity="center_vertical" android:padding="8dp">
    <ImageView android:id="@+id/w_art" android:layout_width="56dp" android:layout_height="56dp" android:scaleType="centerCrop" android:background="#FF0B6B45" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFFFF"
            android:textSize="17sp" android:fontFamily="sans-serif-light" android:singleLine="true" android:ellipsize="end" android:text="GroveMedia" />
        <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B3FFFFFF"
            android:textSize="12sp" android:singleLine="true" android:ellipsize="end" android:text="tap to play" />
    </LinearLayout>
    <ImageButton android:id="@+id/w_prev" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_n_prev" android:background="@null" android:contentDescription="previous" />
    <ImageButton android:id="@+id/w_play" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_n_play" android:background="@null" android:contentDescription="play" />
    <ImageButton android:id="@+id/w_next" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_n_next" android:background="@null" android:contentDescription="next" />
</LinearLayout>
