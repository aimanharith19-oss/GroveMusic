<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
    android:background="@drawable/gm_widget_bg" android:gravity="center_vertical" android:padding="6dp">
    <ImageView android:id="@+id/w_art" android:layout_width="40dp" android:layout_height="40dp" android:scaleType="centerCrop" android:background="#FF0B6B45" />
    <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="10dp"
        android:textColor="#FFFFFFFF" android:textSize="14sp" android:singleLine="true" android:ellipsize="end" android:text="GroveMedia" />
    <ImageButton android:id="@+id/w_play" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_n_play" android:background="@null" android:contentDescription="play" />
    <ImageButton android:id="@+id/w_next" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_n_next" android:background="@null" android:contentDescription="next" />
</LinearLayout>
